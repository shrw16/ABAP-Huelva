@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'NombreEmp'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'NombreCert'
annotate view ZC_ZCERTIFICADOS with
{
  @UI.facet: [ {
    label: 'Información General', 
    id: 'GeneralInfo', 
    purpose: #STANDARD, 
    position: 10 , 
    type: #IDENTIFICATION_REFERENCE,
    targetQualifier: 'GeneralInfo'
  },
  {  
  label: 'Fechas',
  id: 'Fechas',
  purpose: #STANDARD,
  position: 20,
  type: #IDENTIFICATION_REFERENCE,
  targetQualifier: 'Fechas'
  } ] 
    @EndUserText.label: 'Id Certificado'
  @UI.identification: [ 
    { position: 10, label: 'Id Certificado', qualifier: 'GeneralInfo' },
    { position: 3, type: #FOR_ACTION, dataAction: 'UploadFlatFile', label: 'Adjuntar documentos', qualifier: 'GeneralInfo' }
  ]
  @UI.lineItem: [ 
    { position: 10, label: 'Id Certificado' },
    { position: 3, type: #FOR_ACTION, dataAction: 'UploadFlatFile', label: 'Adjuntar documentos' }
  ]
  @UI.selectionField: [ {
    position: 10 
  } ]
  IdCert;
  
  @EndUserText.label: 'Id Empleado'
  @UI.identification: [ {
    position: 20 , 
    label: 'Id Empleado' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 20 , 
    label: 'Id Empleado'
  } ]
  @UI.selectionField: [ {
    position: 20 
  } ]
  IdEmp;
  
  @EndUserText.label: 'Nombre'
  @UI.identification: [ {
    position: 30 , 
    label: 'Nombre' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 30 , 
    label: 'Nombre'
  } ]
  @UI.selectionField: [ {
    position: 30 
  } ]
  NombreEmp;
  
  @EndUserText.label: 'Apellidos'
  @UI.identification: [ {
    position: 40 , 
    label: 'Apellidos' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 40 , 
    label: 'Apellidos'
  } ]
  @UI.selectionField: [ {
    position: 40 
  } ]
  ApellidosEmp;
  
  @EndUserText.label: 'Certificado'
