    position: 50 , 
    label: 'Certificado' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 50 , 
    label: 'Certificado'
  } ]
  @UI.selectionField: [ {
    position: 50 
  } ]
  NombreCert;
  
   @EndUserText.label: 'Entidad Emisora'
  @UI.identification: [ {
    position: 60 ,
    label: 'Entidad Emisora' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 60 ,
    label: 'Entidad Emisora'
  } ]
//  @UI.selectionField: [ {
