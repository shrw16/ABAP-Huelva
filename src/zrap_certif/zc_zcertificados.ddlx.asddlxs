@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'NombreEmp'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'AreaProf'
@UI.headerInfo.typeImageUrl: 'sap-icon://account'
@UI.selectionVariant: [
  {
    qualifier: 'Vigentes',
    text: 'Vigentes',
    filter: 'Vencido EQ ''VIGENTE'''
  },
  {
    qualifier: 'Vencidos',
    text: 'Vencidos',
    filter: 'Vencido EQ ''CADUCADO'''
  }
]
annotate view ZC_ZCERTIFICADOS with
{
  // Referencia DataPoint para el Header
  @UI.facet: [ {
    purpose: #HEADER,
    position: 10,
    type: #DATAPOINT_REFERENCE,
    targetQualifier: 'Certificacion'
  },
  {
    purpose: #HEADER,
    position: 20,
    type: #DATAPOINT_REFERENCE,
    targetQualifier: 'FechaCad'
  },
  {
    label: 'Ficha personal',
    id: 'GeneralInfo',
    purpose: #STANDARD,
    position: 30 ,
    type: #IDENTIFICATION_REFERENCE,
    targetQualifier: 'GeneralInfo'
  },
  {
  label: 'Control de Fechas',
  id: 'Fechas',
  purpose: #STANDARD,
  position: 40,
  type: #IDENTIFICATION_REFERENCE,
  targetQualifier: 'Fechas'
  } ]
  @EndUserText.label: 'Id Certificado'
  @UI.identification: [
    { position: 10, label: 'Id Certificado', qualifier: 'GeneralInfo' },
    { position: 4, type: #FOR_ACTION, dataAction: 'UploadFlatFile', label: '⎙ Adjuntar documentos', qualifier: 'GeneralInfo' },
    { position: 3, type: #FOR_ACTION, dataAction: 'SendMail', label: '✉ Notificar', qualifier: 'GeneralInfo' },
    { position: 5, type: #FOR_ACTION, dataAction: 'Renovar', label: '↻ Renovar certificado', qualifier: 'GeneralInfo' }
  ]
  @UI.lineItem: [
    { position: 10, label: 'Id Certificado' }
  ]
  @UI.selectionField: [ {
    position: 10
  } ]
  IdCert;

  @EndUserText.label: 'Id Empleado'
  @UI.identification: [ {
    position: 20 ,
    label: 'Id Empleado' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 20 ,
    label: 'Id Empleado'
  } ]
  @UI.selectionField: [ {
    position: 20
  } ]
  IdEmp;

  @EndUserText.label: 'Nombre'
  @UI.identification: [ {
    position: 30 ,
    label: 'Nombre' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 30 ,
    label: 'Nombre'
  } ]
  @UI.selectionField: [ {
    position: 30
  } ]
  NombreEmp;

  @EndUserText.label: 'Apellidos'
  @UI.identification: [ {
    position: 40 ,
    label: 'Apellidos' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 40 ,
    label: 'Apellidos'
  } ]
  @UI.selectionField: [ {
    position: 40
  } ]
  ApellidosEmp;

  // Anotación UI.dataPoint añadida para Certificado (header)
  @EndUserText.label: 'Certificado'
  @UI.identification: [ {
    position: 50 ,
    label: 'Certificado' ,
    qualifier: 'Fechas'
  } ]
  @UI.lineItem: [ {
    position: 50 ,
    label: 'Certificado'
  } ]
  @UI.selectionField: [ {
    position: 50
  } ]
  @UI.dataPoint: { qualifier: 'Certificacion', title: 'Certificado' }
  NombreCert;

  @EndUserText.label: 'Emisor'
  @UI.identification: [ {
    position: 60 ,
    label: 'Emisor' ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 60 ,
    label: 'Emisor'
  } ]
  //  @UI.selectionField: [ {
  //    position: 60
  //  } ]
  OrgEmisor;

  @EndUserText.label: 'Fecha Expedición'
  @UI.identification: [ {
    position: 70 ,
    label: 'Fecha Expedición' ,
    qualifier: 'Fechas'
  } ]
  @UI.lineItem: [ {
    position: 70 ,
    label: 'Fecha Expedición'
  } ]
  //  @UI.selectionField: [ {
  //    position: 70
  //  } ]
  FechaExp;

  // Annotación UI.dataPoint reutilizando la criticality ya definida
  @EndUserText.label: 'Fecha de Caducidad'
  @UI.identification: [ {
    position: 80 ,
    label: 'Fecha de Caducidad' ,
    qualifier: 'Fechas'
  } ]
  @UI.lineItem: [ {
    position: 80 ,
      criticality: 'DataCriticality',
      criticalityRepresentation: #WITH_ICON ,
    label: 'Fecha de Caducidad'
  } ]
  //  @UI.selectionField: [ {
  //    position: 80
  //  } ]
  @UI.dataPoint: {
    qualifier: 'FechaCad',
    title: 'Fecha de Caducidad',
    criticality: 'DataCriticality',
    criticalityRepresentation: #WITH_ICON
  }
  FechaCad;

  @EndUserText.label: 'Categoría Profesional'
  @UI.identification: [ {
    position: 90 ,
    qualifier: 'GeneralInfo'
  } ]
  @UI.lineItem: [ {
    position: 90 ,
    label: 'Categoría Prof.'
  } ]
  //  @UI.selectionField: [ {
  //    position: 90
  //  } ]
  PosicionEmp;

  @EndUserText.label: 'Área'
  @UI.identification: [ {
    position: 100,
    label: 'Área',
    qualifier: 'GeneralInfo'
  } ]
  @UI.fieldGroup: [ {
    qualifier: 'AreaList',
    position: 10
  } ]
  @UI.lineItem: [ {
    position: 100,
    label: 'Área',
    type: #AS_FIELDGROUP,
    valueQualifier: 'AreaList'
  } ]
  // @UI.selectionField: [ {
  //   position: 100
  // } ]
  AreaProf;

  @UI.fieldGroup: [ {
  qualifier: 'AreaList',
  position: 5
  } ]
  AreaIcon;


  //  @UI.lineItem: [ {
  //  position: 3 ,
  //  type: #FOR_ACTION ,
  //  dataAction: 'UploadFlatFile' ,
  //  label: 'UploadFlatFile' } ]
  //  uploadflatfile;

}
