  headerInfo: {
    typeName: 'Pedido',
    typeNamePlural: 'Pedidos',
    title: { type: #STANDARD, value: 'OrderId' },
    description: { value: 'NombreCliente' }
  }
}
annotate view ZI_PIZZERIA_05 with
{
  @UI.facet: [
    {
      id: 'Pedido',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Datos del pedido',
      position: 10
    }
  ]

  @UI: {
    lineItem: [{ position: 10 }],
    identification: [{ position: 10 }]
  }
  @EndUserText.label: 'Nº Pedido'
  OrderId;

  @UI: {
    lineItem: [{ position: 20 }],
    identification: [{ position: 20 }]
  }
  @EndUserText.label: 'Cliente'
